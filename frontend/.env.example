# FastAPI backend (Person 1). Everything still works with the backend offline.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Supabase public client. Use the anon key only, never the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# UUIDs produced by POST /seed-demo. Needed for the live API to resolve records.
NEXT_PUBLIC_DEMO_OFFERING_ID=
NEXT_PUBLIC_DEMO_SESSION_ID=
NEXT_PUBLIC_DEMO_STUDENT_ID=
NEXT_PUBLIC_DEMO_FACULTY_ID=
NEXT_PUBLIC_DEMO_COURSE_ID=
NEXT_PUBLIC_DEMO_EVAL_ID=
