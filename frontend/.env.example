# FastAPI backend. This deployed URL is also the default if the variable is unset.
# Use http://localhost:8000/api/v1 when running backend/ locally.
NEXT_PUBLIC_API_URL=https://campusai-backend-ak60.onrender.com/api/v1

# Supabase public client. Use the publishable/anon key only, never the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
