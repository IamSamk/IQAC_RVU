SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable/anon key works while demo RLS policies are on; prefer the service-role key in production
SUPABASE_KEY=<anon-or-publishable-key>
# SUPABASE_SERVICE_ROLE_KEY=
AUTO_SEED=true
RBAC_STRICT=false
# Google Gemini API (OCR vision, ASR, notes, activities, KG examples). Without it the deterministic engines are used.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
